{
  "form": "I539-CARTA-EMPREGADOR",
  "title": "Carta do Empregador",
  "description": "Formulário para gerar a Carta do Empregador (Letter of Employment), assinada pelo empregador, para requerentes que não têm empresa própria e precisam demonstrar vínculo empregatício e intenção de retorno. Em inglês, pronta para impressão e assinatura. Campos marcados com * são obrigatórios.",
  "sections": [
    {
      "id": "requerente",
      "title": "Requerente"
    },
    {
      "id": "carta_empregador",
      "title": "Carta do Empregador"
    }
  ],
  "questions": [
    {
      "id": "nome_completo_requerente",
      "section": "requerente",
      "label": "Nome completo do requerente (para quem as cartas serão escritas)",
      "type": "text",
      "required": true
    },
    {
      "id": "tem_empresa_propria",
      "section": "vinculo_profissional",
      "label": "Você tem uma empresa registrada em seu nome no seu país de origem?",
      "type": "radio",
      "required": true,
      "options": [
        {
          "value": "sim",
          "label": "Sim, tenho empresa própria"
        },
        {
          "value": "nao",
          "label": "Não, preciso de uma carta de um empregador"
        }
      ],
      "hint": "Esta carta é para quem NÃO tem empresa própria e precisa de uma carta assinada pelo empregador. Se você tem empresa própria, use o formulário \"Carta de Responsável pela Empresa\" em vez deste."
    },
    {
