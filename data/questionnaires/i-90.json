    {
      "id": "meu_status",
      "section": "tipo_aplicacao",
      "label": "Meu status é:",
      "type": "radio",
      "required": true,
      "options": [
        {
          "value": "residente_permanente",
          "label": "Residente Permanente Legal"
        },
        {
          "value": "residente_comutante",
          "label": "Residente Permanente em Status de Comutante"
        },
        {
          "value": "residente_condicional",
          "label": "Residente Permanente Condicional"
        }
      ],
      "hint": "\"Comutante\" é quem mora fora dos EUA (geralmente Canadá ou México) mas trabalha nos EUA como residente permanente, sem morar lá em tempo integral — situação rara. \"Condicional\" é residência permanente com validade de só 2 anos (baseada em casamento recente ou investimento) — confira a validade no seu cartão atual. Se seu cartão diz 10 anos e você mora nos EUA, é \"Residente Permanente Legal\"."
    },
    {
      "id": "motivo_secao_a",
      "section": "tipo_aplicacao",
      "label": "Se você é Residente Permanente ou Comutante — motivo da aplicação:",
      "type": "radio",
      "required": false,
      "options": [
        {
          "value": "perdido_roubado_destruido",
