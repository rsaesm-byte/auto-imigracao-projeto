{
  "form": "I539-CARTA-EMPRESA",
  "title": "Carta de Responsável pela Empresa",
  "description": "Formulário para gerar a Carta de Responsável pela Empresa (Letter of Business Management During Absence), assinada pelo próprio requerente, nomeando quem vai administrar sua empresa durante a estadia nos Estados Unidos. Em inglês, pronta para impressão e assinatura. Campos marcados com * são obrigatórios.",
  "sections": [
    {
      "id": "requerente",
      "title": "Requerente"
    },
    {
      "id": "carta_empresa_cuidador",
      "title": "Carta de Responsável pela Empresa"
    }
