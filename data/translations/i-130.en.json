  "questions": {
    "rel_tipo": {
      "label": "What is your relationship to the person you are sponsoring (the beneficiary)?",
      "options": {
        "conjuge": "Spouse (husband/wife)",
        "filho": "Son/Daughter",
        "pai_mae": "Parent (father or mother)",
        "irmao": "Brother or Sister"
      }
    },
    "rel_tipo_filho": {
      "label": "What type of parent-child relationship is it?",
      "options": {
        "legitimo": "Legitimate child (born during the marriage)",
        "adotado": "Adopted child",
        "enteado": "Stepchild",
        "ilegitimo": "Child born out of wedlock"
      },
      "hint": "Biological = your own biological child. Stepchild = your spouse's child (from a prior or current marriage), not biologically yours. Adopted = legal adoption before age 16 (or 18 for siblings adopted together), with at least 2 years under your legal custody. Each type needs different documents — confirm with our team if unsure."
    },
    "rel_irmao_adocao": {
      "label": "If the beneficiary is your brother or sister, are you related through adoption (not biologically)?",
      "options": {
        "sim": "Yes",
        "nao": "No"
      },
      "hint": "Answer Yes only if one of you was adopted (you're not blood siblings, not even half-siblings). Adoptive siblings only qualify if the adoption happened before age 18, with at least 2 years of legal custody (INA 101(b)(1)(E))."
    },
    "rel_lpr_via_adocao": {
      "label": "Did you obtain permanent residence or U.S. citizenship through adoption?",
      "options": {
        "sim": "Yes",
        "nao": "No"
      },
      "hint": "Important for sibling petitions: if you became a resident/citizen through adoption, this can affect whether you may petition for a biological (non-adopted) sibling. Confirm with our team — this rule has exceptions."
    },
