# Copie este arquivo para ".env" (sem o .example) e preencha com sua chave real.
# ".env" já está no .gitignore -- nunca será commitado.
# Usada pelo chatbot (app/chatbot.py) e pela carta narrativa do I-539
# (scripts/generate_cartas_i539.py) -- gerada em aistudio.google.com/apikey.
GEMINI_API_KEY=AQ...

# Criptografa as credenciais USCIS/Embaixada do CRM (app/services/crypto.py)
# -- sem isso, nenhuma credencial pode ser salva (falha alto e claro, nunca
# grava em texto puro). Gere uma com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar esta chave em produção invalida todas as credenciais já salvas.
CRM_CREDENTIALS_KEY=
